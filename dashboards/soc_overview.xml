<dashboard theme="dark" version="1.1">
  <label>Home Lab SOC - Detection Overview</label>
  <description>Eight MITRE ATT&amp;CK techniques run against victim01, each caught by a purpose-built Splunk detection, then correlated into session-level incidents. github.com/SecByAlii/home-lab-soc</description>

  <search id="base">
    <query>`soc_detections`</query>
    <earliest>-30d@d</earliest>
    <latest>now</latest>
  </search>

  <row>
    <panel>
      <title>Sessions of concern — detections correlated by actor into incidents (risk = 5·detections + 20·tactics)</title>
      <table>
        <search>
          <query>`soc_incidents` | eval Window=strftime(first_seen,"%Y-%m-%d %H:%M")." (+".span_min."m)" | rename actor as Actor, severity as Severity, risk_score as Risk, detections as "Detections", tactics as "ATT&amp;CK tactics", sig as "Detections in this session" | table Window Actor Severity Risk "Detections" "ATT&amp;CK tactics" "Detections in this session"</query>
          <earliest>-30d@d</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">10</option>
        <option name="wrap">true</option>
        <format type="color" field="Severity">
          <colorPalette type="map">{"CRITICAL":#B50101,"HIGH":#D6563C,"LOW":#F1813F}</colorPalette>
        </format>
        <format type="color" field="Risk">
          <colorPalette type="minMidMax" maxColor="#B50101" midColor="#D6563C" minColor="#F1813F"></colorPalette>
          <scale type="minMidMax"></scale>
        </format>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <single>
        <title>Detections fired</title>
        <search base="base"><query>| stats count</query></search>
        <option name="drilldown">none</option>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x53a051","0x53a051"]</option>
        <option name="rangeValues">[0]</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>ATT&amp;CK techniques covered</title>
        <search base="base"><query>| stats dc(mitre)</query></search>
        <option name="drilldown">none</option>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x006d9c","0x006d9c"]</option>
        <option name="rangeValues">[0]</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Correlated incidents</title>
        <search><query>`soc_incidents` | stats count</query>
          <earliest>-30d@d</earliest><latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0xd6563c","0xd6563c"]</option>
        <option name="rangeValues">[0]</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>Detection timeline — the simulated intrusion, in order</title>
      <table>
        <search base="base">
          <query>| sort _time | eval _time=strftime(_time,"%Y-%m-%d %H:%M:%S") | rename _time as "Time", detection as "Detection", mitre as "MITRE ID", tactic as "ATT&amp;CK Tactic", actor as "Actor", detail as "What fired it" | table "Time" "Detection" "MITRE ID" "ATT&amp;CK Tactic" "Actor" "What fired it"</query>
        </search>
        <option name="drilldown">none</option>
        <option name="count">20</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Detections by ATT&amp;CK tactic</title>
      <chart>
        <search base="base">
          <query>| stats count as Detections by tactic | rename tactic as "ATT&amp;CK Tactic" | sort - Detections</query>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.legend.placement">none</option>
        <option name="charting.chart.showDataLabels">all</option>
        <option name="charting.axisTitleX.visibility">collapsed</option>
        <option name="charting.axisTitleY.visibility">collapsed</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
    <panel>
      <title>Technique → detection map</title>
      <table>
        <search base="base">
          <query>| stats values(detection) as "Detection" by mitre tactic | rename mitre as "MITRE ID", tactic as "ATT&amp;CK Tactic" | sort "MITRE ID"</query>
        </search>
        <option name="drilldown">none</option>
        <option name="count">10</option>
      </table>
    </panel>
  </row>
</dashboard>
