## T1053.003 — Scheduled Task/Job: Cron
## Instrumentation for detection 5. Load on victim01 with:
##   sudo cp 50-cron.rules /etc/audit/rules.d/ && sudo augenrules --load
##
## Watches every cron config location for writes / attribute changes (-p wa),
## and flags execution of the crontab binary (-p x). The two keys let the
## detection separate "a cron file changed" from "someone ran crontab".

-w /etc/crontab -p wa -k cron_persist
-w /etc/cron.d/ -p wa -k cron_persist
-w /etc/cron.daily/ -p wa -k cron_persist
-w /etc/cron.hourly/ -p wa -k cron_persist
-w /etc/cron.weekly/ -p wa -k cron_persist
-w /etc/cron.monthly/ -p wa -k cron_persist
-w /var/spool/cron/crontabs/ -p wa -k cron_persist
-w /usr/bin/crontab -p x -k cron_exec
